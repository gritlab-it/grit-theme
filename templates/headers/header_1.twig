{#
 * GRIT_SET Header 1 | Standard bar with inline mobile expansion
 * Legend
 * 01 | Main bar with inline mobile navigation
 * 02 | Sticky bar with independent inline navigation
 * Edit this file directly: logo, buttons and menu placement are kept here.
 * menu.twig renders the WordPress menu tree; nav-social.twig owns social links.
 #}

{# * GRIT_SET 01 | Main bar. #}
<div class="header-menu">
    <nav class="navbar navbar-expand-lg static-top header-inline-bar" aria-label="{{ __('Navigazione principale', 'grit_theme') }}">
        <div class="header-brand">
            <a class="navbar-brand" href="{{ home|e('html_attr') }}" title="{{ site.name|e('html_attr') }}">
                <img class="logo img-fluid" src="{{ (custom_logo_url ? custom_logo_url[0] : 'https://placehold.co/100x100/000000/FFFFFF/png')|e('html_attr') }}" alt="{{ site.name|e('html_attr') }}">
            </a>
        </div>
        <button class="navbar-toggler menu-toggle" type="button" data-inline-menu-toggle aria-controls="header-1-normal-menu" aria-expanded="false" aria-label="{{ __('Apri menu', 'grit_theme') }}">
            <i class="fas fa-bars" aria-hidden="true"></i>
        </button>
        <div class="navbar-collapse desktop-primary header-inline-nav" id="header-1-normal-menu" data-inline-menu data-lenis-prevent>
            {% include 'headers/menu.twig' with {menu_items: primary_menu.get_items, class_menu: 'primary_menu'} %}
            {% include 'headers/nav-social.twig' %}
        </div>
    </nav>
</div>

{# * GRIT_SET 02 | Sticky bar. #}
<div class="sticky sticky-fix" aria-hidden="true" inert>
    <nav class="navbar navbar-expand-lg static-top header-inline-bar" aria-label="{{ __('Navigazione principale', 'grit_theme') }}">
        <div class="header-brand">
            <a class="navbar-brand" href="{{ home|e('html_attr') }}" title="{{ site.name|e('html_attr') }}">
                <img class="logo img-fluid" src="{{ (custom_logo_url ? custom_logo_url[0] : 'https://placehold.co/100x100/000000/FFFFFF/png')|e('html_attr') }}" alt="{{ site.name|e('html_attr') }}">
            </a>
        </div>
        <button class="navbar-toggler menu-toggle" type="button" data-inline-menu-toggle aria-controls="header-1-sticky-menu" aria-expanded="false" aria-label="{{ __('Apri menu', 'grit_theme') }}">
            <i class="fas fa-bars" aria-hidden="true"></i>
        </button>
        <div class="navbar-collapse desktop-primary header-inline-nav" id="header-1-sticky-menu" data-inline-menu data-lenis-prevent>
            {% include 'headers/menu.twig' with {menu_items: primary_menu.get_items, class_menu: 'primary_menu'} %}
            {% include 'headers/nav-social.twig' %}
        </div>
    </nav>
</div>
