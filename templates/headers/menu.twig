{# * GRIT_SET Menu | Parent links remain usable; separate buttons expand nested menus on touch/keyboard. #}
{% macro items(menu_items, root, class_menu) %}
    {% if menu_items %}
    <ul class="{{ root ? 'nav navbar-nav' : 'dropdown-menu' }}{% if class_menu %} {{ class_menu|e('html_attr') }}{% endif %}">
        {% for item in menu_items %}
            {% set children = item.get_children %}
            {% set submenu_id = children ? function('wp_unique_id', 'grit-submenu-') : '' %}
            <li class="nav-item {{ children ? 'dropdown' : '' }} {{ item.classes|join(' ')|e('html_attr') }}">
                <a href="{{ function('esc_url', item.get_link)|e('html_attr') }}"{% if item.target %} target="{{ item.target|e('html_attr') }}"{% if item.target == '_blank' %} rel="noopener noreferrer"{% endif %}{% endif %}{% if item.current %} aria-current="page"{% endif %}><span data-letters="{{ item.title|e('html_attr') }}">{{ item.title|e }}</span></a>
                {% if children %}
                    <button class="submenu-toggle dropdown-toggle" type="button" data-submenu-toggle aria-expanded="false" aria-controls="{{ submenu_id }}" aria-label="{{ __('Open submenu:', 'grit') }} {{ item.title|e('html_attr') }}"></button>
                    <div id="{{ submenu_id }}" class="submenu-container" hidden>
                        {{ _self.items(children, false, '') }}
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
    {% endif %}
{% endmacro %}
{{ _self.items(menu_items, true, class_menu|default('')) }}
