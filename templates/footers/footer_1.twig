{# * GRIT_SET Legend | Footer 1
01 | Logo and company contacts.
02 | Footer menu, independent widget columns and social links.
03 | Copyright and legal links.
One layout for light/dark backgrounds: edit $footer-1-background in _variables.scss.
Shared appearance is in _footer.scss.
#}
{% set footer_links = footer_menu.get_items ?: primary_menu.get_items %}
{% set privacy_url = function('grit_policy_url', 'privacy') %}
{% set cookie_url = function('grit_policy_url', 'cookie') %}

{# * GRIT_SET 01 | Company column. #}
<div class="section-footer contained py-5">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-5 col-lg-4 mb-5 mb-md-0">
                <div class="footer-logo mb-4">
                    <a href="{{ function('esc_url', home)|e('html_attr') }}">
                        {% if custom_logo_url[0] %}
                            <img src="{{ function('esc_url', custom_logo_url[0])|e('html_attr') }}" alt="{{ site.name|e('html_attr') }}" class="img-fluid">
                        {% else %}
                            <span class="h3">{{ site.name|e }}</span>
                        {% endif %}
                    </a>
                </div>
                {% if setting_intestazione %}
                    <h3 class="h5">{{ setting_intestazione|e }}</h3>
                {% endif %}
                {% if setting_indirizzo_1 %}
                    <p>
                        <a href="https://www.google.com/maps/dir/?api=1&amp;destination={{ setting_indirizzo_1|url_encode }}" target="_blank" rel="noopener noreferrer">{{ setting_indirizzo_1|e }}</a>
                    </p>
                {% endif %}
                {% if setting_mail_1 or setting_tel_1 %}
                    <ul class="footer-contacts list-unstyled mb-0">
                        {% if setting_mail_1 %}
                            <li><a href="{{ function('esc_url', 'mailto:' ~ setting_mail_1)|e('html_attr') }}">{{ setting_mail_1|e }}</a></li>
                        {% endif %}
                        {% if setting_tel_1 %}
                            <li><a href="{{ function('esc_url', 'tel:' ~ setting_tel_1|replace({' ': '', '(': '', ')': '', '-': '', '.': ''}))|e('html_attr') }}">{{ setting_tel_1|e }}</a></li>
                        {% endif %}
                    </ul>
                {% endif %}
            </div>
            <div class="col-12 col-md-7 offset-lg-1">
                {# * GRIT_SET 02 | Each widget area remains directly editable. #}
                <div class="row">
                    <div class="col-12 col-sm-6 col-lg-4 mb-4">
                        {{ footer_col_1 }}
                        {% if footer_links %}
                            <nav aria-label="{{ __('Footer menu', 'grit')|e('html_attr') }}">
                                <ul class="footer-menu list-unstyled mb-0">
                                    {% for item in footer_links %}
                                        <li class="{{ item.classes|join(' ')|e('html_attr') }}">
                                            <a href="{{ function('esc_url', item.get_link)|e('html_attr') }}"{% if item.target %} target="{{ item.target|e('html_attr') }}"{% if item.target == '_blank' %} rel="noopener noreferrer"{% endif %}{% endif %}>{{ item.title|e }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </nav>
                        {% endif %}
                    </div>
                    {% if footer_col_2 %}
                        <div class="col-12 col-sm-6 col-lg-4 mb-4">{{ footer_col_2 }}</div>
                    {% endif %}
                    {% if footer_col_3 %}
                        <div class="col-12 col-sm-6 col-lg-4 mb-4">{{ footer_col_3 }}</div>
                    {% endif %}
                    {% if footer_col_4 %}
                        <div class="col-12 mb-4">{{ footer_col_4 }}</div>
                    {% endif %}
                </div>
                {% if setting_facebook or setting_instagram or setting_linkedin %}
                    <div class="footer-social">
                        {% include 'headers/nav-social.twig' %}
                    </div>
                {% endif %}
                {# The existing newsletter page receives the email; this form does not subscribe directly. #}
                <form class="footer-newsletter mt-4" action="{{ function('esc_url', function('home_url', '/newsletter/'))|e('html_attr') }}" method="get">
                    <label for="footer-newsletter-email">{{ __('Subscribe to our newsletter', 'grit') }}</label>
                    <div class="footer-newsletter-controls">
                        <input type="email" class="form-control" name="mailnewsletter" id="footer-newsletter-email" autocomplete="email" placeholder="{{ __('Email address', 'grit')|e('html_attr') }}" required>
                        <button type="submit" class="btn btn-accent">{{ __('Subscribe', 'grit') }}</button>
                    </div>
                </form>
                {% if footer_bottom %}
                    <div class="footer-widgets-bottom mt-4">{{ footer_bottom }}</div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{# * GRIT_SET 03 | Copyright and legal links. Empty company fields are omitted. #}
<div class="footer-bottom contained py-3">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-12 col-md-6 mb-3 mb-md-0">
                <p class="mb-0">© {{ "now"|date('Y') }} {{ setting_intestazione|default(site.name)|e }}{% if setting_piva %} · {{ __('VAT no.', 'grit') }} {{ setting_piva|e }}{% endif %}</p>
            </div>
            <div class="col-12 col-md-6">
                <ul class="footer-policy list-unstyled mb-0">
                    {% if privacy_url %}<li><a href="{{ function('esc_url', privacy_url)|e('html_attr') }}">{{ __('Privacy Policy', 'grit')|e }}</a></li>{% endif %}
                    {% if cookie_url %}<li><a href="{{ function('esc_url', cookie_url)|e('html_attr') }}">{{ __('Cookie Policy', 'grit')|e }}</a></li>{% endif %}
                </ul>
            </div>
        </div>
    </div>
</div>
