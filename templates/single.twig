{#
 * GRIT_SET Single legend
 * 01 | Sections before content
 * 02 | Image, title, content and post details
 * 03 | Sections after content
 * 04 | Related posts
 * 05 | Native comments
 #}
{% extends 'base.twig' %}

{% block content %}
    <article class="single single-type-{{ post.post_type }}" id="post-{{ post.ID }}">
        {# * GRIT_SET 01 | Local sections and one-level section-page references. #}
        {% include 'partials/sections.twig' with {sections: sections|default([]), pre_content: true} %}

        {# * GRIT_SET 02 | Edit the main post layout here. PHP prepares title and content. #}
        <section class="section_page contained">
            <div class="container-fluid">
                {% if post.thumbnail %}
                    <div class="row">
                        <div class="col-12 text-center py-4">
                            <img src="{{ post.thumbnail.src|resize(1800, 600) }}"
                                 alt="{{ post.thumbnail.alt|default(title)|e('html_attr') }}"
                                 class="img-fluid shadow-sm">
                        </div>
                    </div>
                {% endif %}

                <div class="row">
                    <div class="col-12 col-md-10 mx-auto py-4">
                        <h1 class="display-2">{{ function('esc_html', title) }}</h1>
                        <p class="lead">{{ post.post_excerpt|e }}</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-lg-10 mx-auto py-4">
                        <div class="single-{{ post.post_type }}-body my-4">{{ content }}</div>

                        <section class="single-{{ post.post_type }}-header py-4">
                            <p class="single-{{ post.post_type }}-author">
                                <strong class="text-uppercase">{{ post.post_type }}</strong> {{ __(' scritto da', 'grit') }}
                                <a href="{{ post.author.link|e('html_attr') }}" class="text-decoration-none"> {{ post.author.name|e }} </a>
                            </p>
                            <p class="single-{{ post.post_type }}-date">
                                <small>{{ __('Data: ', 'grit') }} : {{ post.post_date|date('d/M/Y') }}</small>
                            </p>

                            {# * GRIT_SET Post categories and tags. #}
                            {% set categories = post.terms('category') %}
                            {% if categories|length %}
                                <h5 class="single-{{ post.post_type }}-category mt-3">
                                    <strong>{{ __('Category:', 'grit') }}</strong>
                                    {% for category in categories %}
                                        <a href="{{ category.link|e('html_attr') }}" title="{{ post.title|e('html_attr') }} - {{ category.name|e('html_attr') }}" class="badge bg-primary mr-1">{{ category.name|e }}</a>
                                    {% endfor %}
                                </h5>
                            {% endif %}

                            {% set tags = post.terms('post_tag') %}
                            {% if tags|length %}
                                <h5 class="single-{{ post.post_type }}-tag mt-3">
                                    <strong>{{ __('Tag:', 'grit') }}</strong>
                                    {% for tag in tags %}
                                        <a href="{{ tag.link|e('html_attr') }}" title="{{ post.title|e('html_attr') }} - {{ tag.name|e('html_attr') }}" class="badge bg-secondary mr-1">{{ tag.name|e }}</a>
                                    {% endfor %}
                                </h5>
                            {% endif %}

                            {# * GRIT_SET Optional custom taxonomy: replace this slug with a registered taxonomy. #}
                            {% set custom_taxonomy = 'custom_taxonomy' %}
                            {% set custom_terms = [] %}
                            {% if function('taxonomy_exists', custom_taxonomy) %}
                                {% set custom_terms = post.terms(custom_taxonomy) %}
                            {% endif %}
                            {% if custom_terms|length %}
                                <h5 class="single-{{ post.post_type }}-tax mt-3">
                                    <strong>{{ __('Tax:', 'grit') }}</strong>
                                    {% for tax in custom_terms %}
                                        <a href="{{ tax.link|e('html_attr') }}" title="{{ post.title|e('html_attr') }} - {{ tax.name|e('html_attr') }}" class="badge bg-info mr-1">{{ tax.name|e }}</a>
                                    {% endfor %}
                                </h5>
                            {% endif %}
                        </section>
                        <hr class="my-4">
                    </div>
                </div>
            </div>
        </section>

        {# * GRIT_SET 03 | Sections below the main post content. #}
        {% include 'partials/sections.twig' with {sections: sections|default([]), pre_content: false} %}

        {# * GRIT_SET 04 | Edit the related-post query in single.php and card layout here. #}
        {% if archive_posts|length %}
            <section class="section_archive section_archive_carousel contained py-6">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col">
                            <div class="owl-carousel owl-theme">
                                {% set grid = ' ' %}
                                {% for single_post in archive_posts %}
                                    {% include ['partials/tease-' ~ post.post_type ~ '.twig', 'partials/tease.twig'] with {post: single_post, grid: grid} %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {% endif %}

        {# * GRIT_SET 05 | WordPress comments, prepared once by single.php. #}
        {{ comments_html }}
    </article>
{% endblock %}
