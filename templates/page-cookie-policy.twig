{#
 * GRIT_SET Page Cookie Policy
 * Legend
 * 01 | Sections Before Content
 * 02 | Cookie Policy Content
 * 03 | Sections After Content
 #}
 
 
 
 
 

{% extends "base.twig" %}

{% block content %}

<article class="post-type-{{post.post_type}}" id="post-{{post.ID}}">

{# * GRIT_SET 01 | Sections Before Content #} 
{% include 'partials/sections.twig' with { sections: sections|default([]), pre_content: true } %}
 

{# * GRIT_SET 02 | Cookie Policy Content #} 
	{% if content is not empty %}
	    <section class="section_page contained py-3">
	        <div class="container-fluid">
	            <div class="row">
	                <div class="col-12">   
	                    {{ content }}
	                </div>
	            </div>
	        </div>
	    </section>
        {% elseif function('shortcode_exists', 'cmplz-document') %}
        <section class="section_page contained py-3">
	        <div class="container-fluid">
	            <div class="row">
	                <div class="col-12">
                        {% filter shortcodes %}
                            [cmplz-document type="cookie-statement" region="eu"]
                        {% endfilter %}
	                </div>
	            </div>
	        </div>
	    </section> 

		<style>
        @import url("{{ function('plugins_url', 'complianz-gdpr/assets/css/document.min.css')|e('css') }}");
        #cmplz-document {
            max-width: 100%;
            text-justify: inter-word;
        }
    	</style>

    {% else %}
        <section class="section_page contained py-3">
            <div class="container-fluid">
                <h1>{{ post.title|e }}</h1>
                <p>{{ __('Il documento non è ancora disponibile.', 'grit') }}</p>
            </div>
        </section>
    {% endif %}
 

{# * GRIT_SET 03 | Sections After Content #} 
{% include 'partials/sections.twig' with { sections: sections|default([]), pre_content: false } %}
 

</article>

{% endblock %}


