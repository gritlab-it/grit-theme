{#
 * GRIT_SET Policy page legend
 * 01 | ACF sections before content
 * 02 | Shared Bootstrap grid and theme typography
 * 03 | ACF sections after content
 #}
{% extends 'base.twig' %}

{% block content %}
    <article class="post-type-{{ post.post_type }}" id="post-{{ post.ID }}">
        {# * GRIT_SET 01 | Preserve the configured content order. #}
        {% include 'partials/sections.twig' with {sections: sections|default([]), pre_content: true} %}

        {# * GRIT_SET 02 | A centered reading column uses existing theme utilities only. #}
        <section class="section_page contained py-5 py-md-7">
            <div class="container-fluid">
                <div class="row justify-content-center">
                    <div class="col-12 col-lg-10 col-xl-8">
                        <header class="border-bottom pb-4 mb-4 mb-md-5">
                            <p class="small text-uppercase text-muted mb-2">{{ site.name|e }}</p>
                            <h1 class="display-4 mb-0">{{ post.title|e }}</h1>
                        </header>
                        {% if content is not empty %}
                            {{ content }}
                        {% elseif function('shortcode_exists', 'cmplz-document') %}
                            {% filter shortcodes %}
                                [cmplz-document type="cookie-statement" region="eu"]
                            {% endfilter %}
                            {# Plugin layout; document width and body typography are adapted in _sections.scss. #}
                            <style>
                                @import url("{{ function('plugins_url', 'complianz-gdpr/assets/css/document.min.css')|e('css') }}");
                            </style>
                        {% else %}
                            <div class="bg-light rounded p-4 p-md-5">
                                <p class="mb-0">{{ __('Il documento non è ancora disponibile.', 'grit') }}</p>
                            </div>
                        {% endif %}

                        <nav class="border-top pt-4 mt-5" aria-label="{{ __('Documenti del sito', 'grit')|e('html_attr') }}">
                            {% set related_policy_url = function('grit_policy_url', 'privacy') %}
                            {% if related_policy_url %}
                                <a class="btn btn-outline-dark" href="{{ related_policy_url|e('html_attr') }}">Privacy Policy</a>
                            {% endif %}
                        </nav>
                    </div>
                </div>
            </div>
        </section>

        {# * GRIT_SET 03 | Preserve sections placed after the document. #}
        {% include 'partials/sections.twig' with {sections: sections|default([]), pre_content: false} %}
    </article>
{% endblock %}
