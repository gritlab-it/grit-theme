{#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::#}
{# :::::::::::::: 01 * GRIT_SET Page Cookie Policy #} 
{# :::::::::::::: 02 * GRIT_SET Section Pre Content #} 
{# :::::::::::::: 03 * GRIT_SET Cookie Policy Content #} 
{# :::::::::::::: 04 * GRIT_SET Section #} 
{#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::#} 

{% extends "base.twig" %}

{% block content %}

<article class="post-type-{{post.post_type}}" id="post-{{post.ID}}">

{# :::::::::::::: 02 * GRIT_SET Section Pre Content #} 
{% for section in sections %}
    {% if section.acf_fc_layout == 'section_page' and section.page %}
        {% set ref_sections = fn('get_field', 'sections', section.page.ID) %}
        {% for ref_section in ref_sections %}
            {% if ref_section.pre_content %}
                {% set ref_section = ref_section|merge({
                    'section_index': loop.index ~ '-' ~ loop.index0
                }) %}
                {% include ['/sections/section.twig'] with { section: ref_section } %}
            {% endif %}
        {% endfor %}
    {% elseif section.pre_content %}
        {% set section = section|merge({'section_index': loop.index}) %}
        {% include ['/sections/section.twig'] with section %}
    {% endif %}
{% endfor %}
{# :::::::::::::: 02 * GRIT_SET Section Pre Content END  #} 

{# :::::::::::::: 03 * GRIT_SET Cookie Policy Content #} 
	{% if content is not empty %}
	    <section class="section_page contained py-3">
	        <div class="container-fluid">
	            <div class="row">
	                <div class="col-12">   
	                    {{ content }}
	                </div>
	            </div>
	        </div>
	    </section>
        {% else %}
        <section class="section_page contained py-3">
	        <div class="container-fluid">
	            <div class="row">
	                <div class="col-12">
                        {% filter shortcodes %}
                            [cmplz-document type="cookie-statement" region="eu"]
                        {% endfilter %}
	                </div>
	            </div>
	        </div>
	    </section> 

		<style>
        @import url("{{ home }}/wp-content/plugins/complianz-gdpr/assets/css/document.min.css");
        #cmplz-document {
            max-width: 100%;
            text-justify: inter-word;
        }
    	</style>

	{% endif %}
{# :::::::::::::: 03 * GRIT_SET Cookie Policy Content END #} 

{# :::::::::::::: 04 * GRIT_SET Section #} 
{% for section in sections %}
    {% if section.acf_fc_layout == 'section_page' and section.page %}
        {% set ref_sections = fn('get_field', 'sections', section.page.ID) %}
        {% for ref_section in ref_sections %}
            {% if not ref_section.pre_content %}
                {% set ref_section = ref_section|merge({
                    'section_index': loop.index ~ '-' ~ loop.index0
                }) %}
                {% include ['/sections/section.twig'] with { section: ref_section } %}
            {% endif %}
        {% endfor %}
    {% elseif not section.pre_content %}
        {% set section = section|merge({'section_index': loop.index}) %}
        {% include ['/sections/section.twig'] with section %}
    {% endif %}
{% endfor %}
{# :::::::::::::: 04 * GRIT_SET Section #} 

</article>

{% endblock %}


