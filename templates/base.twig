{#
 * GRIT_SET Base legend
 * 01 | Document head
 * 02 | Loader and header
 * 03 | Page content and optional sidebar
 * 04 | Footer and WordPress scripts
 #}
{% block html_head_container %}
    {# * GRIT_SET 01 | Individual templates may add content to the head block. #}
    {% include 'html-header.twig' %}
    {% block head %}{% endblock %}
    </head>
{% endblock %}

<body class="{{ body_class }}" data-template="base.twig">
    {{ function('wp_body_open') }}
    {# * GRIT_SET 02 | Edit each header in its own headers/header_N.twig file. #}
    {% include 'partials/loader.twig' %}
    <a class="skip-link screen-reader-text" href="#content">{{ __('Vai al contenuto', 'grit_theme') }}</a>

    {% set header_name = grit_setting_header|default('header_1') %}
    <header id="{{ header_name }}" class="grit-header">
        {% include ['headers/' ~ header_name ~ '.twig', 'headers/header_1.twig'] %}
    </header>

    {# * GRIT_SET 03 | Child templates replace the content block. #}
    <section id="content" role="main" class="content-wrapper">
        <div class="wrapper {{ sidebar_class }}">
            {% block content %}Sorry, no content{% endblock %}
        </div>
        {% if sidebar %}
            <aside class="layout-sidebar">{{ sidebar }}</aside>
        {% endif %}
    </section>

    {# * GRIT_SET 04 | Footer layouts remain independent files. #}
    {% block footer %}
        {% set footer_name = grit_setting_footer|default('footer_1') %}
        <footer id="{{ footer_name }}" class="footer">
            {% include ['footers/' ~ footer_name ~ '.twig', 'footers/footer_1.twig'] %}
        </footer>
        {{ function('wp_footer') }}
    {% endblock %}
</body>
</html>
