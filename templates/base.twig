{#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::#}
{# :::::::::::::: 01 * GRIT_SET html-header #} 
{# :::::::::::::: 02 * GRIT_SET loader #} 
{# :::::::::::::: 03 * GRIT_SET header #} 
{# :::::::::::::: 04 * GRIT_SET content #} 
{# :::::::::::::: 05 * GRIT_SET footer #} 
{#:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::#}

{% block html_head_container %}


{# :::::::::::::: 01 * GRIT_SET html-header #} 
{% include 'html-header.twig' %}
	{% block head %}
	{% endblock %}
	</head>
{% endblock %}
{# :::::::::::::: 01 * GRIT_SET html-header END #} 

<body class="{{body_class}} " data-template="base.twig">

	{# :::::::::::::: 02 * GRIT_SET loader #} 
    {% include ['/partials/loader.twig'] %}
    {# :::::::::::::: 02 * GRIT_SET loader END #} 
 	
	<a class="skip-link screen-reader-text" href="#content">{{ _e( 'Skip to content') }}</a>

	{# :::::::::::::: 03 * GRIT_SET header #}  
    	{% if grit_setting_header %}
			 <header id="{{ grit_setting_header }}">  
				{% include ['headers/'~ grit_setting_header ~'.twig'] %}
			</header> 
		{% else %}
			<header id="header_1"> 
			 	{% include "headers/header_1.twig" %}
			 </header>
		{% endif %}  
	{# :::::::::::::: 03 * GRIT_SET header END#} 
 		 
	{# :::::::::::::: 04 * GRIT_SET content #} 
	<section id="content" role="main" class="content-wrapper  ">
	 
		<div class="wrapper {{sidebar_class}}">
			{% block content %}
				Sorry, no content
			{% endblock %}
		</div>

		{% if sidebar %}
			<aside class="layout-sidebar">
				{{sidebar}}
			</aside>
		{% endif %}

	</section>
	{# :::::::::::::: 04 * GRIT_SET content END #} 

	{# :::::::::::::: 05 * GRIT_SET footer #}  
    {% block footer %} 
		{% if grit_setting_footer %}
				<footer id="{{ grit_setting_footer }}" class="footer">
					{% include ['/footers/'~ grit_setting_footer ~'.twig'] %}
				</footer>
			{% else %}
				<footer id="footer_1" class="footer">
					{% include ['/footers/footer_1.twig'] %}
				</footer>
		{% endif %}
		{{ function('wp_footer') }}
		
    {% endblock %}
	{# :::::::::::::: 05 * GRIT_SET footer END #}  
	
	{# 
	<script> 
        window.navLeftArrow = `{% include '/partials/arrow.twig' %}`;
        window.navRightArrow = `{% include '/partials/arrow.twig' %}`; 
    </script>  
	#}
</body>
</html>
