{#
 * GRIT_SET Bio | Mobile-first profile, curated links and existing contact fields.
 * Header and loader are omitted; WordPress footer scripts remain available.
 #}
{% extends 'base.twig' %}
{% block loader %}{% endblock %}
{% block header %}{% endblock %}

{% block content %}
    <article class="post-type-{{ post.post_type }}" id="post-{{ post.ID }}">
        {% include 'partials/sections.twig' with {sections: sections|default([]), pre_content: true} %}
        <section class="section_bio">
            <div class="bio-shell">
                <header class="bio-profile text-center">
                    {% if post.thumbnail %}
                        <img class="bio-avatar" src="{{ post.thumbnail.src('medium')|e('html_attr') }}" alt="{{ site.name|e('html_attr') }}" width="96" height="96">
                    {% elseif custom_logo_url[0]|default('') %}
                        <img class="bio-avatar bio-avatar-logo" src="{{ custom_logo_url[0]|e('html_attr') }}" alt="{{ site.name|e('html_attr') }}" width="96" height="96">
                    {% else %}
                        <span class="bio-avatar bio-avatar-initial" aria-hidden="true">{{ site.name|slice(0, 1)|upper|e }}</span>
                    {% endif %}
                    <h1 class="display-5 mt-4 mb-2">{{ site.name|e }}</h1>
                    <div class="bio-description">
                        {% if content is not empty %}{{ content }}{% elseif site.description %}<p>{{ site.description|e }}</p>{% endif %}
                    </div>
                </header>

                <nav class="link-list-bio" aria-label="{{ __('Link principali', 'grit')|e('html_attr') }}">
                    <a class="bio-link bio-link-featured no-load" href="{{ home|e('html_attr') }}">
                        <span class="bio-link-icon" aria-hidden="true"><i class="fas fa-globe"></i></span>
                        <span class="bio-link-copy"><strong>{{ __('Visita il sito', 'grit') }}</strong><span>{{ site.name|e }}</span></span>
                        <span class="bio-link-arrow" aria-hidden="true">↗</span>
                    </a>
                    {% for item in bio_menu.get_items|default([]) %}
                        {% set item_url = function('esc_url', item.link) %}
                        {% if item_url %}
                            <a class="bio-link no-load" href="{{ item_url|e('html_attr') }}"{% if item.target == '_blank' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                                <span class="bio-link-icon" aria-hidden="true"><i class="fas fa-link"></i></span>
                                <span class="bio-link-copy"><strong>{{ item.title|striptags|e }}</strong>{% if item.description %}<span>{{ item.description|striptags|e }}</span>{% endif %}</span>
                                <span class="bio-link-arrow" aria-hidden="true">↗</span>
                            </a>
                        {% endif %}
                    {% endfor %}
                </nav>

                {# Contacts use the existing Theme Fields directly. #}
                {% if setting_mail_2 or setting_tel_2 or setting_tel_3 or setting_indirizzo_2 %}
                    <h2 class="bio-label">{{ __('Parliamone', 'grit') }}</h2>
                    <div class="bio-contacts">
                        {% if setting_mail_2 %}
                            <a class="bio-contact no-load" href="mailto:{{ setting_mail_2|e('html_attr') }}">
                                <i class="bio-contact-icon far fa-envelope" aria-hidden="true"></i>
                                <strong>{{ __('Scrivici', 'grit') }}</strong>
                                <span>{{ setting_mail_2|e }}</span>
                            </a>
                        {% endif %}
                        {% if setting_tel_2 %}
                            <a class="bio-contact no-load" href="tel:{{ function('preg_replace', '/[^0-9+]/', '', setting_tel_2)|e('html_attr') }}">
                                <i class="bio-contact-icon fas fa-phone" aria-hidden="true"></i>
                                <strong>{{ __('Chiamaci', 'grit') }}</strong>
                                <span>{{ setting_tel_2|e }}</span>
                            </a>
                        {% endif %}
                        {% if setting_tel_3 %}
                            {% set whatsapp = function('preg_replace', '/[^0-9]+/', '', setting_tel_3) %}
                            {% if whatsapp starts with '00' %}{% set whatsapp = whatsapp|slice(2) %}{% endif %}
                            <a class="bio-contact no-load" href="https://wa.me/{{ whatsapp|e('html_attr') }}" target="_blank" rel="noopener noreferrer">
                                <i class="bio-contact-icon fab fa-whatsapp" aria-hidden="true"></i>
                                <strong>WhatsApp</strong>
                                <span>{{ __('Iniziamo una conversazione', 'grit') }}</span>
                            </a>
                        {% endif %}
                        {% if setting_indirizzo_2 %}
                            <a class="bio-contact no-load" href="https://www.google.com/maps/dir/?api=1&amp;destination={{ setting_indirizzo_2|url_encode|e('html_attr') }}" target="_blank" rel="noopener noreferrer">
                                <i class="bio-contact-icon fas fa-map-marker-alt" aria-hidden="true"></i>
                                <strong>{{ __('Dove siamo', 'grit') }}</strong>
                                <span>{{ setting_indirizzo_2|e }}</span>
                            </a>
                        {% endif %}
                    </div>
                {% endif %}

                {# Add or remove social profiles here, using the existing Theme Fields. #}
                {% set socials = [
                    {title: 'Instagram', url: setting_instagram, icon: 'fab fa-instagram'},
                    {title: 'LinkedIn', url: setting_linkedin, icon: 'fab fa-linkedin-in'},
                    {title: 'Facebook', url: setting_facebook, icon: 'fab fa-facebook-f'},
                    {title: 'TikTok', url: setting_tiktok, icon: 'fab fa-tiktok'}
                ] %}
                {% set social_links %}
                    {% for social in socials %}
                        {% if social.url starts with 'https://' or social.url starts with 'http://' %}
                            <a class="no-load" href="{{ function('esc_url', social.url)|e('html_attr') }}" target="_blank" rel="noopener noreferrer" aria-label="{{ social.title|e('html_attr') }}"><i class="{{ social.icon|e('html_attr') }}" aria-hidden="true"></i></a>
                        {% endif %}
                    {% endfor %}
                {% endset %}
                {% if social_links|trim %}
                    <nav class="bio-socials" aria-label="{{ __('Profili social', 'grit')|e('html_attr') }}">{{ social_links }}</nav>
                {% endif %}

                <div class="text-center mt-4">
                    {% set share_message = site.name ~ ' — ' ~ post.link %}
                    <a class="bio-share no-load" href="https://wa.me/?text={{ share_message|url_encode|e('html_attr') }}" target="_blank" rel="noopener noreferrer"><i class="fas fa-share-alt mr-2" aria-hidden="true"></i>{{ __('Condividi questa pagina', 'grit') }}</a>
                </div>
            </div>
        </section>
        {% include 'partials/sections.twig' with {sections: sections|default([]), pre_content: false} %}
    </article>
{% endblock %}

{% block footer %}
    <footer class="bg-light text-center py-4 px-3">
        <small>© {{ 'now'|date('Y') }} {{ site.name|e }}</small>
        <nav class="small mt-2" aria-label="{{ __('Documenti del sito', 'grit')|e('html_attr') }}">
            {% set privacy_url = function('grit_policy_url', 'privacy') %}
            {% set cookie_url = function('grit_policy_url', 'cookie') %}
            {% if privacy_url %}<a class="mx-2 no-load" href="{{ privacy_url|e('html_attr') }}">Privacy Policy</a>{% endif %}
            {% if cookie_url %}<a class="mx-2 no-load" href="{{ cookie_url|e('html_attr') }}">Cookie Policy</a>{% endif %}
        </nav>
    </footer>
    {{ function('wp_footer') }}
{% endblock %}
