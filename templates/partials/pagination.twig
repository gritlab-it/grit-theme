{# * GRIT_SET Pagination | Use the caller's pagination object, or build it from posts. #}
{% if pagination is not defined and posts is defined %}
    {% set pagination = posts.pagination({show_all: false, mid_size: 3, end_size: 2}) %}
{% endif %}

{% if pagination.pages|default([])|length > 1 %}
    <nav class="pagination-block" aria-label="{{ __('Paginazione', 'grit') }}">
        <ul class="pagination">
            <li class="mx-1 prev">
                {% if pagination.prev %}
                    <a class="btn btn-accent" href="{{ pagination.prev.link|e('html_attr') }}" aria-label="{{ __('Pagina precedente', 'grit') }}">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </a>
                {% else %}
                    <button class="btn btn-accent disabled" disabled aria-label="{{ __('Pagina precedente', 'grit') }}">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </li>

            {% for page in pagination.pages %}
                {% set page_label = page.class == 'dots' ? '…' : page.title %}
                <li class="mx-1{% if page.current %} current{% endif %}">
                    {% if page.link and not page.current %}
                        <a class="btn btn-accent {{ page.class|e('html_attr') }}" href="{{ page.link|e('html_attr') }}">{{ page_label|e }}</a>
                    {% else %}
                        <span class="{{ page.class|e('html_attr') }} btn btn-accent disabled"{% if page.current %} aria-current="page"{% endif %}>{{ page_label|e }}</span>
                    {% endif %}
                </li>
            {% endfor %}

            <li class="mx-1 next">
                {% if pagination.next %}
                    <a class="btn btn-accent" href="{{ pagination.next.link|e('html_attr') }}" aria-label="{{ __('Pagina successiva', 'grit') }}">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </a>
                {% else %}
                    <button class="btn btn-accent disabled" disabled aria-label="{{ __('Pagina successiva', 'grit') }}">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </li>
        </ul>
    </nav>
{% endif %}
