{% extends "partials/tease.twig" %}

{% block content %}
	<div class="card in__animate " data-animation="animate__fadeIn animate__slow ">
		<div class="card-img">
			<a href="{{post.link}}">
				<div class="gsap-parallax-container">
					{% if post.thumbnail %}
						{% set image = {
					'alt': post.thumbnail,
					'src': Image(post.thumbnail.id).src ,
					'class': 'gsap-parallaxImage '
					}
					%}
						{% include ['/partials/img.twig'] with image %}
					{% endif %}
				</div>
			</a>
		</div>
		<div class="card-body">
			<h6 class="card-subtitle mb-2">
				<span class="color-accent">■</span>
				{{ post.terms('') | join(', ') }}
			</h6>
			<h3 class="card-title">
				<a href="{{post.link}}">{{post.title}}</a>
			</h3>
		</div>
		<div class="card-body inner-text">
			<div class="card-text">{{ post.get_preview( split_content_post|length + 10, false, '', false )|apply_filters('the_content') }}
			</div>
		</div>
	</div>
{% endblock %}
