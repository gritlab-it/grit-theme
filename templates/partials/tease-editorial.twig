{# * GRIT_SET editorial | Standard reusable card; missing images never reserve empty columns #}
{% extends "partials/tease.twig" %}
{% block content %}
<div class="card grit-tease-card">{% if post.thumbnail %}<a class="tease-media" href="{{ post.link|e('html_attr') }}">{% include 'partials/card-image.twig' with { post: post, image_class: 'img-fluid' } only %}</a>{% endif %}<div class="card-body">{% set categories = post.terms('category') %}{% if categories|length %}<p class="small text-muted mb-2">{{ categories|join(', ')|e }}</p>{% endif %}<p class="small text-muted"><time datetime="{{ post.date('c')|e('html_attr') }}">{{ post.date|e }}</time></p><h3 class="card-title"><a href="{{ post.link|e('html_attr') }}">{{ post.title|e }}</a></h3>{% set excerpt = function('grit_archive_excerpt', post, 25) %}{% if excerpt %}<p class="card-text">{{ excerpt|e }}</p>{% endif %}<a href="{{ post.link|e('html_attr') }}" class="btn btn-accent">{{ __('Leggi', 'grit_theme') }}</a></div>{% set tags = post.terms('post_tag') %}{% if tags|length %}<div class="card-footer small">{{ tags|join(', ')|e }}</div>{% endif %}</div>
{% endblock %}
