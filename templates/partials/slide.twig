{# * GRIT_SET Shared slide | Responsive decorative image, escaped title and shared buttons #}
<div class="item-slide{% if single %} item-slide-single{% endif %}{% if slide.background_color %} bg-{{ slide.background_color|e('html_attr') }}{% endif %}{% if parallax and slide.background %} jarallax-keep-img{% endif %}">
    {% if slide.background %}
        {{ function('wp_get_attachment_image', slide.background.id|default(slide.background.ID)|default(slide.background), 'full', false, {
            class: parallax ? 'slide-background jarallax-img' : 'slide-background',
            alt: '', sizes: '100vw', loading: first ? 'eager' : 'lazy'
        }) }}
    {% endif %}
    <div class="inner-text">
        <div class="container-fluid{% if contained %} contained{% endif %}">
            <div class="row">
                <div class="col-12{% if slide.align in ['left', 'center', 'right', 'justify'] %} text-{{ slide.align|e('html_attr') }}{% endif %}">
                    {% if slide.title %}<h2{% if slide.text_color %} class="color-{{ slide.text_color|e('html_attr') }}"{% endif %}>{{ slide.title|e }}</h2>{% endif %}
                    {% if slide.text %}<div class="lead font-weight-normal pb-3{% if slide.text_color %} color-{{ slide.text_color|e('html_attr') }}{% endif %}">{{ slide.text }}</div>{% endif %}
                    {% include 'partials/buttons.twig' with {
                        buttons: [
                            { title: slide.link_1.title, url: slide.link_1.url, target: slide.link_1.target, style: 'btn btn-' ~ slide.color_link_1|default('primary') },
                            { title: slide.link_2.title, url: slide.link_2.url, target: slide.link_2.target, style: 'btn btn-' ~ slide.color_link_2|default('primary') }
                        ], buttons_class: '', buttons_animation: ''
                    } only %}
                </div>
            </div>
        </div>
    </div>
</div>
