{#
 * GRIT_SET Cube block legend
 * 01 | No gallery: full-width text; one image: static; multiple images: shared Owl
 * 02 | Invert changes desktop order; mobile keeps text before media
 * 03 | Exact parallax token, static image only; shared buttons and responsive media
 #}
{% set gallery = block.gallery|default([]) %}
{% set has_media = gallery|length > 0 %}
{% set carousel = gallery|length > 1 %}
{% set modifiers = block.class|default('')|split(' ') %}
{% set parallax = not carousel and has_media and 'parallax' in modifiers %}
{% set has_text = block.title is not empty or block.text or block.lists or block.link_1.url or block.link_2.url %}
{% if has_media or has_text %}
<div class="container-fluid">
    <div class="row align-items-stretch{% if block.contained and block.background_color %} bg-{{ block.background_color|e('html_attr') }}{% endif %}">
        {% if has_text %}
        <div class="col-12{% if has_media %} col-md-8 col-lg-6{% endif %} p-0 col-text d-flex flex-column justify-content-center{% if not block.contained and block.background_color %} bg-{{ block.background_color|e('html_attr') }}{% endif %} order-first{% if block.invert %} order-md-last{% endif %}">
            <div class="inner-text{% if block.text_color %} color-{{ block.text_color|e('html_attr') }}{% endif %}">
                {% if block.title is not empty %}<h2>{{ function('wp_kses_post', block.title) }}</h2>{% endif %}
                {% if block.text %}<div class="py-3">{{ block.text }}</div>{% endif %}
                {% if block.lists %}<div class="row pb-4">
                    {% for item in block.lists %}
                        {% if item.icon or item.text %}<div class="col-12 item-list">
                            <div class="inner-item-list{% if block.text_color %} border-{{ block.text_color|e('html_attr') }}{% endif %} d-flex align-items-center mb-3 pb-2">
                                {% if item.icon %}{{ function('wp_get_attachment_image', item.icon.id|default(item.icon.ID)|default(item.icon), 'thumbnail', false, { class: 'cube-list-icon mr-2', alt: '', loading: 'lazy' }) }}{% endif %}
                                <div>{{ item.text }}</div>
                            </div>
                        </div>{% endif %}
                    {% endfor %}
                </div>{% endif %}
                {% include 'partials/buttons.twig' with {
                    buttons: [
                        { title: block.link_1.title, url: block.link_1.url, target: block.link_1.target, style: 'btn btn-' ~ block.color_link_1|default('primary') },
                        { title: block.link_2.title, url: block.link_2.url, target: block.link_2.target, style: 'btn btn-' ~ block.color_link_2|default('secondary') }
                    ], buttons_class: '', buttons_animation: ''
                } only %}
            </div>
        </div>
        {% endif %}
        {% if has_media %}
        <div class="col-12{% if has_text %} col-md-4 col-lg-6{% endif %} p-0 col-img order-last{% if block.invert %} order-md-first{% endif %}">
            {% if carousel %}<div class="owl-carousel owl-theme carousel-cube">{% endif %}
            {% for image in gallery %}
                <div class="item-gallery cube-frame{% if parallax %} jarallax-keep-img{% endif %}"{% if parallax %} data-speed="0.5"{% endif %}>
                    {{ function('wp_get_attachment_image', image.id|default(image.ID)|default(image), 'full', false, {
                        class: parallax ? 'cube-image jarallax-img' : 'cube-image',
                        sizes: has_text ? '(min-width: 992px) 50vw, (min-width: 768px) 34vw, 100vw' : '100vw',
                        loading: 'lazy'
                    }) }}
                </div>
            {% endfor %}
            {% if carousel %}</div>{% endif %}
        </div>
        {% endif %}
    </div>
</div>
{% endif %}
