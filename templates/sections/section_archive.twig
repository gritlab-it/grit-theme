{#
 * GRIT_SET Section Archive legend
 * 01 | Independent PHP query, validated card template and exact carousel token
 * 02 | Shared item columns; one card loop for grid and carousel
 * Class | section_archive_carousel; shared carousel-* settings and light/dark controls
 #}
{% import 'partials/grid-classes.twig' as archive_grid %}
{% if archive_data is not defined %}{% set archive_data = function('grit_archive_section_data', section) %}{% endif %}
{% set archive_items = archive_data.posts %}
{% set carousel = 'section_archive_carousel' in section.class|default('')|split(' ') and archive_items|length > 1 %}
{% set grid = function('html_entity_decode', archive_grid.classes(section.inner_class|default(''), archive_items|length, section.align|default(''), carousel)|trim, 3, 'UTF-8') %}
{% if archive_items|length %}
    {# * GRIT_SET 02 | Outer column classes control section width; Inner Class controls individual cards #}
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="{{ col_classes|default([])|join(' ')|default('col-12')|e('html_attr') }}">
                <div class="{% if carousel %}owl-carousel owl-theme{% else %}row{% endif %}">
                    {% for archive_post in archive_items %}
                        {% include ['partials/tease-' ~ archive_data.tease ~ '.twig', 'partials/tease.twig'] with {
                            post: archive_post,
                            grid: carousel and not grid ? ' ' : grid,
                            tease_style: archive_data.tease
                        } %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endif %}
