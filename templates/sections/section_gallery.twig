{#
 * GRIT_SET gallery_carousel
 * Legend
 * 01 | gallery_carousel
 * 02 | section_gallery
 * 03 | single_image
 #}


 
 
 
{% if section.gallery|length > 1 %}  
    {% if 'gallery_carousel' in section.class|default('')|split(' ') %} 
        {# * GRIT_SET 01 | gallery_carousel #} 
        <div class="container-fluid ">
            <div class="row">
                <div class="col ">
                    <div class="owl-carousel owl-theme ">
                        {% for item in section.gallery %}
                            {% set image = Image(item.id) %}
                            <a class="item item-img-gallery no-load"
                               data-lightbox-gallery="item-gallery-{{ section.section_index|e('html_attr') }}"
                               data-width="{{ image.width }}"
                               data-height="{{ image.height }}"
                               href="{{ image.src|e('html_attr') }}"
                               title="{{ item.alt|e('html_attr') }}">
                                {{ function('grit_gallery_carousel_image', item.id, section.class|default('')) }}
                            </a>
                        {% endfor %}
                    </div> 
                </div>
            </div> 
        </div>

        
    {% else %}
    {# * GRIT_SET 02 | section_gallery #} 
    {% set image_ids = section.gallery | map(image => image.id) | join(',') %}
    <div class="container-fluid ">
        <div class="row">
            <div class="col-12">
                <div class="section_gallery">
                    {{ function('do_shortcode', '[gallery ids="' ~ image_ids ~ '" columns="'~ section.columns ~'" size="' ~ section.size ~ '" link="file" ]') }}
                </div>
            </div>
        </div>
    </div>
     
    {% endif %} 
{% else %}
    {# * GRIT_SET 03 | single_image #}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 in__animate " data-animation="animate__fadeIn animate__slow ">
                {% set classes = section.class ? section.class|split(' ') : [] %}

                {% if section.gallery[0] %} 
                    {% if 'parallax-gsap' in classes %}
                          
                        <div class="gsap-parallax-container">
                            {% set image = {
                            'alt': section.gallery[0].alt,
                            'src': Image(section.gallery[0].id).src,
                            'class': 'gsap-parallaxImage'
                        } %}
                            {% include ['/partials/img.twig'] with image %}
                        </div>
                         
                {% elseif 'parallax' in classes %} 
                
                    <div class="jarallax-keep-img overlay-in" data-speed="0.2">
                        {% set image = {
                                'alt': section.gallery[0].alt,
                                'src': Image(section.gallery[0].id).src,
                                'class': 'img-fluid jarallax-img'
                            } %}
                        {% include ['/partials/img.twig'] with image %}
                    </div> 
                {% else %}
                    {% set image = {
                            'alt': section.gallery[0].alt,
                            'src': Image(section.gallery[0].id).src,
                            'class': 'img-fluid'
                        } %}
                    {% include ['/partials/img.twig'] with image %}
                {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
    
{% endif %}

