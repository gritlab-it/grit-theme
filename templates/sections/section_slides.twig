{#
 * GRIT_SET Slides legend
 * 01 | Empty, single and multiple slides share one renderer
 * 02 | Owl uses the shared carousel settings; static content remains readable without Owl
 * Classes | slides-height-auto / slides-height-small / slides-height-medium (default: full screen)
 * Classes | slides-content-top / slides-content-center (default: bottom)
 * Classes | slides-overlay / slides-overlay-light / slides-no-overlay; slides-zoom
 * Parallax | Exact `parallax` token, single slide only; reduced motion disables it
 #}
{% set slides = section.slides|default([]) %}
{% set slide_classes = section.class|default('')|split(' ') %}
{% if slides|length %}
    {# * GRIT_SET 01 | Keep a single slide static; Owl is only needed for multiple slides #}
    <div class="slides-track{% if slides|length > 1 %} owl-carousel owl-theme carousel-slider{% endif %}">
        {% for slide in slides %}
            {% include 'partials/slide.twig' with {
                slide: slide,
                single: slides|length == 1,
                contained: section.contained|default(false),
                parallax: slides|length == 1 and 'parallax' in slide_classes,
                first: loop.first
            } only %}
        {% endfor %}
    </div>
{% endif %}
