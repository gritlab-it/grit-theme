{#
 * GRIT_SET Section Text
 * Legend
 * 01 | Layout selection
 * 02 | Chapters and column classes
 * 03 | Shared chapter content
 #}

{# * GRIT_SET 01 | Layout selection using exact class tokens #}
{% import 'partials/grid-classes.twig' as grid %}
{% set section_classes = section.class|default('')|split(' ') %}
{% set is_carousel = 'section_carousel_text' in section_classes %}
{% set is_masonry = not is_carousel and 'section_masonry' in section_classes %}
{% set chapters = section.chapters|default([]) %}
<div class="container-fluid{% if not is_carousel %} img-hover-inner{% endif %}">
    {% if is_carousel %}
        <div class="row"><div class="col p-0"><div class="owl-carousel owl-theme">
    {% elseif is_masonry %}
        <div class="masonry-grid js-grit-masonry row">
    {% else %}
        <div class="row{% if section.align == 'center' %} justify-content-center{% endif %}">
    {% endif %}

    {# * GRIT_SET 02 | Separate Bootstrap sizing from chapter modifiers #}
    {% for item in chapters %}
        {% set item_classes = item.inner_class|default('')|split(' ') %}
        {% if is_carousel %}
            <div class="inner-list {{ grid.classes(item.inner_class, chapters|length, section.align, true) }}">
        {% else %}
            <div class="item-chapters{% if is_masonry %} masonry-item{% endif %} {{ grid.classes(item.inner_class, chapters|length, section.align, false) }}" id="section_id_{{ section.section_index|e('html_attr') }}_{{ loop.index }}">
            <div class="inner-item">
        {% endif %}
            {# * GRIT_SET 03 | Image, text and links shared by all layouts #}
            {% include 'partials/text-chapter.twig' %}
        {% if is_carousel %}</div>{% else %}</div></div>{% endif %}
    {% endfor %}

    {% if is_carousel %}</div></div></div>{% else %}</div>{% endif %}
</div>
