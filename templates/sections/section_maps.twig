{# * GRIT_SET Legend | Section Maps
01 | Independent Bootstrap columns for text and map; no text means a full-width map.
02 | Safe JSON data and unique map canvas.
03 | Static locations and directions remain available without the Google SDK.
Styling: assets/maps/style.json. The viewport always follows the configured locations.
#}
{% set map = maps_data|default({}) %}
{% set has_content = section.title or section.text or section.link_1.url or section.link_2.url %}
{% if map.locations|default([])|length %}
    {# * GRIT_SET 01 | Explicit column fields accept ordinary Bootstrap classes and spacing utilities. #}
    <div class="container-fluid">
        <div class="row maps-layout">
            {% if has_content %}
                <div class="maps-content-column {{ section.maps_content_class|default('col-12 col-lg-5 mb-4 mb-lg-0')|e('html_attr') }}">
                    {% if section.title %}<h2>{{ section.title|e }}</h2>{% endif %}
                    {{ section.text }}
                    {% include 'partials/buttons.twig' with {
                        buttons: [
                            {title: section.link_1.title, url: section.link_1.url, target: section.link_1.target, style: 'btn btn-' ~ section.color_link_1|default('primary')},
                            {title: section.link_2.title, url: section.link_2.url, target: section.link_2.target, style: 'btn btn-' ~ section.color_link_2|default('primary')}
                        ]
                    } only %}
                </div>
            {% endif %}
            <div class="maps-media-column {{ (has_content ? section.maps_map_class|default('col-12 col-lg-7') : 'col-12')|e('html_attr') }}">
                <div class="grit-map{% if not map.key %} is-map-unavailable{% endif %}" data-grit-map>
                    {# * GRIT_SET 02 | JSON_HEX_* flags (15) protect script delimiters and quotation marks. #}
                    <script type="application/json" class="grit-map-config">{{ map|json_encode(15)|raw }}</script>
                    <div class="grit-map-canvas" id="{{ map.id|e('html_attr') }}" aria-label="{{ __('Mappa delle sedi', 'grit')|e('html_attr') }}" aria-describedby="{{ map.id|e('html_attr') }}-status"></div>
                    <p class="grit-map-status mt-3" id="{{ map.id|e('html_attr') }}-status" role="status">{{ (map.key ? map.messages.waiting : map.messages.missingKey)|e }}</p>
                    {# * GRIT_SET 03 | Escaped text and coordinate-based directions are independent of the API. #}
                    <ul class="grit-map-locations list-unstyled mt-4 mb-0">
                        {% for location in map.locations %}
                            <li>
                                <h3 class="h5">{{ location.title|e }}</h3>
                                {% if location.description %}<p class="grit-map-description">{{ location.description|e }}</p>{% endif %}
                                <a href="{{ function('esc_url', location.directions)|raw }}" target="_blank" rel="noopener noreferrer">{{ map.messages.directions|e }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endif %}
