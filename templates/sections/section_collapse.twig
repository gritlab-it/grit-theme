{#
 * GRIT_SET Section Collapse
 * Legend
 * 01 | Searchable accordion with per-section pagination
 * 02 | Tabs with standard, grid or Owl content
 * 03 | Grouped standard accordion
 #}
{% set modifiers = section.class|default('')|split(' ') %}
{% set prefix = 'collapse-' ~ section.section_index %}
{% set lists = section.lists|default([]) %}
<div class="container-fluid">
{% if 'section_collapse_search' in modifiers %}
    {# * GRIT_SET 01 | Local List.js is loaded once through WordPress dependencies #}
    <div class="row"><div class="col-12 my-5 js-collapse-search" id="{{ prefix }}-search">
        <div class="py-3">
            <label class="sr-only" for="{{ prefix }}-query">{{ __('Search...', 'grit') }}</label>
            <input id="{{ prefix }}-query" type="search" class="search form-control" placeholder="{{ __('Search...', 'grit') }}" aria-controls="{{ prefix }}-results">
        </div>
        <ul class="list p-0 w-100 list-unstyled" id="{{ prefix }}-results">
        {% for list in lists %}
            {% set group_index = loop.index %}
            {% for item in list.item|default([]) %}
                <li class="item-search mb-1">
                    {% include 'partials/collapse-item.twig' with { item_id: prefix ~ '-' ~ group_index ~ '-' ~ loop.index, accordion_id: prefix ~ '-results', searchable: true, opened: false } %}
                </li>
            {% endfor %}
        {% endfor %}
        </ul>
        <p class="collapse-empty" role="status" hidden>{{ __('No results found.', 'grit') }}</p>
        <nav aria-label="{{ __('Results pagination', 'grit') }}"><ul class="pagination pagination-list-js justify-content-center"></ul></nav>
    </div></div>
{% elseif 'section_collapse_dynamic' in modifiers %}
    {# * GRIT_SET 02 | Every tab ID includes the section prefix #}
    <div class="row"><div class="col-12 pb-sm-5">
        <ul class="nav arg-tabs d-flex justify-content-start" role="tablist" id="{{ prefix }}-tabs">
        {% for list in lists %}
            <li role="presentation"><a class="{{ loop.first ? 'active' : '' }}" id="{{ prefix }}-tab-{{ loop.index }}" data-toggle="tab" href="#{{ prefix }}-panel-{{ loop.index }}" role="tab" aria-controls="{{ prefix }}-panel-{{ loop.index }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ list.args|e }}</a></li>
        {% endfor %}
        </ul>
    </div><div class="col-12"><div class="tab-content pt-5">
        {% for list in lists %}
            {% set list_classes = list.inner_class|default('')|split(' ') %}
            <div class="tab-pane fade{{ loop.first ? ' show active' : '' }}" id="{{ prefix }}-panel-{{ loop.index }}" role="tabpanel" aria-labelledby="{{ prefix }}-tab-{{ loop.index }}">
            {% if 'carousel' in list_classes %}
                <div class="owl-carousel owl-theme pb-5 {{ list_classes|filter(value => value != 'carousel')|join(' ')|e('html_attr') }}">
                    {% for item in list.item|default([]) %}<div class="item"><div class="card"><div class="card-body inner-text">{% if item.title %}<h3>{{ item.title|e }}</h3>{% endif %}
{{ item.text }}
{% include 'partials/buttons.twig' with {
    buttons: [
        { title: item.link_1.title, url: item.link_1.url, target: item.link_1.target, style: 'btn btn-' ~ section.color_link_1|default('primary') },
        { title: item.link_2.title, url: item.link_2.url, target: item.link_2.target, style: 'btn btn-' ~ section.color_link_2|default('primary') }
    ],
    buttons_class: '', buttons_animation: '' 
} only %}</div></div></div>{% endfor %}
                </div>
            {% elseif 'grid' in list_classes %}
                {% set columns = list_classes|filter(value => value == 'col' or value matches '/^col-.*$/') %}
                <div class="collapse-grid position-relative px-3"><div class="row">
                {% for item in list.item|default([]) %}
                    <div class="{{ columns ? columns|join(' ')|e('html_attr') : 'col-12 col-md-4' }} position-relative mb-5">
                        <div class="grid-marker" aria-hidden="true"><span class="dot"></span><div class="line"></div></div>
                        <div class="pr-md-3 pr-lg-4 inner-text">{% if item.title %}<h3>{{ item.title|e }}</h3>{% endif %}
{{ item.text }}
{% include 'partials/buttons.twig' with {
    buttons: [
        { title: item.link_1.title, url: item.link_1.url, target: item.link_1.target, style: 'btn btn-' ~ section.color_link_1|default('primary') },
        { title: item.link_2.title, url: item.link_2.url, target: item.link_2.target, style: 'btn btn-' ~ section.color_link_2|default('primary') }
    ],
    buttons_class: '', buttons_animation: '' 
} only %}</div>
                    </div>
                {% endfor %}
                </div></div>
            {% else %}
                <div class="collapse-standard {{ list.inner_class|e('html_attr') }}">
                {% for item in list.item|default([]) %}<div class="pb-5 inner-text">{% if item.title %}<h3>{{ item.title|e }}</h3>{% endif %}
{{ item.text }}
{% include 'partials/buttons.twig' with {
    buttons: [
        { title: item.link_1.title, url: item.link_1.url, target: item.link_1.target, style: 'btn btn-' ~ section.color_link_1|default('primary') },
        { title: item.link_2.title, url: item.link_2.url, target: item.link_2.target, style: 'btn btn-' ~ section.color_link_2|default('primary') }
    ],
    buttons_class: '', buttons_animation: '' 
} only %}</div>{% endfor %}
                </div>
            {% endif %}
            </div>
        {% endfor %}
    </div></div></div>
{% else %}
    {# * GRIT_SET 03 | One accordion per group; first item starts expanded #}
    <div class="row">
    {% for list in lists %}
        {% set group_index = loop.index %}
        {% set accordion_id = prefix ~ '-group-' ~ group_index %}
        {% if list.args %}<div class="col-12 pt-5"><h2 class="color-{{ list.args_color|e('html_attr') }}">{{ list.args|e }}</h2></div>{% endif %}
        <div class="col-12"><div class="accordion w-100" id="{{ accordion_id }}">
        {% for item in list.item|default([]) %}
            {% include 'partials/collapse-item.twig' with { item_id: prefix ~ '-' ~ group_index ~ '-' ~ loop.index, searchable: false, opened: loop.first } %}
        {% endfor %}
        </div></div>
    {% endfor %}
    </div>
{% endif %}
</div>
